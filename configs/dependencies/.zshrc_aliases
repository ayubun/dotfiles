function opencode() {
  local tmux_window_name=""
  local tmux_automatic_rename=""

  if [ -n "$TMUX" ] && [ -n "$TMUX_PANE" ]; then
    tmux_window_name="$(tmux display-message -t "$TMUX_PANE" -p '#{window_name}' 2>/dev/null)"
    tmux_automatic_rename="$(tmux show-window-options -t "$TMUX_PANE" -v automatic-rename 2>/dev/null)"
  fi

  command opencode "$@"
  local exit_code=$?

  if [ -n "$tmux_window_name" ] && [ -n "$TMUX_PANE" ]; then
    tmux rename-window -t "$TMUX_PANE" -- "$tmux_window_name" 2>/dev/null
    if [ "$tmux_automatic_rename" = "on" ] || [ "$tmux_automatic_rename" = "off" ]; then
      tmux set-window-option -t "$TMUX_PANE" automatic-rename "$tmux_automatic_rename" 2>/dev/null
    else
      # restore inherited automatic-rename behavior
      tmux set-window-option -u -t "$TMUX_PANE" automatic-rename 2>/dev/null
    fi
  fi

  return "$exit_code"
}

